# ==========================================
# Multi-Agent AI Data Analyst - Environment
# ==========================================

# OpenAI API Key (Server-side ONLY: Used by Orchestrator, SQL Agent, Synthesis Agent)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# LangSmith Observability & Agent Monitoring
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_your_api_key_here
LANGCHAIN_PROJECT=multi-agent-data-analyst
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Application Database (Neon PostgreSQL via Prisma)
# Replace with your actual Neon connection string:
# Example: postgresql://username:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
DIRECT_URL=

# Service Endpoints
FRONTEND_URL=http://localhost:3000
BACKEND1_PORT=3001
BACKEND1_URL=http://localhost:3001
BACKEND2_PORT=8000
BACKEND2_URL=http://localhost:8000

# Frontend Public API Client URL (No secrets here!)
NEXT_PUBLIC_BACKEND1_URL=http://localhost:3001

# Security & Tokens
INTERNAL_SERVICE_TOKEN=dev-internal-secret-token-change-in-production
APP_ENCRYPTION_KEY=dev-32-character-secret-key-prod!!

# Storage & Upload Limits
UPLOADS_DIR=d:/major_project/backend2/storage/uploads
RESULTS_DIR=d:/major_project/backend2/storage/generated_results
MAX_UPLOAD_SIZE_MB=50
